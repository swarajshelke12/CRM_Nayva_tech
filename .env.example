# n8n Webhook Trigger URL (Optional: connect live n8n webhook endpoint)
VITE_N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/meeting-os-trigger

# Webhook Authorization Bearer Token (Optional)
VITE_N8N_AUTH_TOKEN=your-secret-token-here

# Supabase Integration (Optional: for persistent auth & storage)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
